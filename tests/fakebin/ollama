#!/bin/bash
# stand-in for the real ollama daemon, for lifecycle testing only
if [ "$1" = "serve" ]; then
  exec python3 -c "
import json
from http.server import BaseHTTPRequestHandler, HTTPServer
class H(BaseHTTPRequestHandler):
    def log_message(self,*a): pass
    def do_GET(self):
        b=json.dumps({'models':[{'name':'deepseek-r1:7b','size':1}]}).encode()
        self.send_response(200); self.send_header('Content-Length',str(len(b)))
        self.end_headers(); self.wfile.write(b)
HTTPServer(('127.0.0.1', 21434), H).serve_forever()
"
fi
